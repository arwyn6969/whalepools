{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "whale-pools-demo",
  "main": "./build/cloudflare-worker.mjs",
  "compatibility_date": "2026-09-21",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "arwyn.party/whalepools",
      "zone_name": "arwyn.party"
    },
    {
      "pattern": "arwyn.party/whalepools/*",
      "zone_name": "arwyn.party"
    },
    {
      "pattern": "arwyn.party/whalepool",
      "zone_name": "arwyn.party"
    },
    {
      "pattern": "arwyn.party/whalepool/*",
      "zone_name": "arwyn.party"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "whale-pools-arcade",
      "database_id": "4b6d5fb2-551f-4d19-9ead-299f6ab425f7",
      "migrations_dir": "migrations"
    }
  ]
}
