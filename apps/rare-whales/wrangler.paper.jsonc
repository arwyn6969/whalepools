{
 "$schema":"./node_modules/wrangler/config-schema.json",
 "name":"whale-pools-paper-staging",
 "main":"./build/paper-worker.mjs",
 "compatibility_date":"2026-09-21",
 "workers_dev":true,
 "preview_urls":false,
 "routes":[],
 "observability":{"enabled":true,"traces":{"enabled":true,"head_sampling_rate":0.1}},
 "triggers":{"crons":["* * * * *"]},
 "durable_objects":{"bindings":[{"name":"PAPER_RECORDER","class_name":"PaperRecorder"}]},
 "migrations":[{"tag":"recorder-sqlite-v1","new_sqlite_classes":["PaperRecorder"]}],
 // Isolated resource: never substitute the production arcade database ID.
 "d1_databases":[{"binding":"DB","database_name":"whale-pools-paper-staging","database_id":"7e7532e6-891f-4b29-bd80-752a1e311642","migrations_dir":"migrations"}],
 "vars":{"BASE_PATH":"/whalepools","PAPER_ENABLED":"1","TIDE_ENABLED":"1","RECORDER_MODE":"durable-object","APP_ORIGIN":"https://whale-pools-paper-staging.mrarwyn.workers.dev","RPC_URL":"https://robinhood.drpc.org"}
}
