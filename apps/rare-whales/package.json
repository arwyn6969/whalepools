{
  "name": "rare-whales-vector-club",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "node --experimental-sqlite scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --experimental-sqlite --test tests/*.test.mjs",
    "deploy:check": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "build:demo": "npm run build && node scripts/bundle-demo.mjs && node scripts/check-demo.mjs",
    "test:runtime": "node scripts/check-runtime.mjs",
    "contracts:build": "node scripts/compile-contracts.mjs",
    "contracts:test": "node scripts/test-contracts.mjs",
    "launch:prepare": "npm run contracts:build && node scripts/prepare-launch.mjs",
    "launch:serve": "node scripts/serve-launch.mjs",
    "launch:verify": "node scripts/verify-launch.mjs"
  },
  "dependencies": {
    "viem": "^2.55.0"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "esbuild": "^0.28.2",
    "solc": "0.8.37",
    "wrangler": "^4.136.1"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
